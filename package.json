{
  "name": "jonathan-blanchard-portfolio",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["frontend"],
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "node scripts/gradle.mjs bootRun --args=--spring.profiles.active=dev",
    "lint": "npm --prefix frontend run lint",
    "typecheck": "npm --prefix frontend run typecheck",
    "test:frontend": "npm --prefix frontend run test",
    "test:e2e": "npm --prefix frontend run e2e",
    "test:backend": "node scripts/gradle.mjs test",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "node scripts/gradle.mjs build",
    "admin": "node scripts/gradle.mjs adminCli",
    "verify": "npm run lint && npm run typecheck && npm run test:frontend && npm run test:backend && npm run build:frontend && npm run build:backend"
  },
  "engines": { "node": ">=24" }
}
