# Public
PUBLIC_SITE_URL=http://localhost:5173
NEXT_PUBLIC_API_BASE_URL=/api/v1
INTERNAL_API_BASE_URL=http://localhost:8080/api/v1
API_PROXY_TARGET=http://localhost:8080

# Database
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=jdbc:postgresql://localhost:5432/portfolio

# Spring
SPRING_PROFILES_ACTIVE=dev
SESSION_COOKIE_SECURE=false
SESSION_TIMEOUT=12h
SERVER_FORWARD_HEADERS_STRATEGY=framework
# Reverse proxies between the internet and the backend. Decides which X-Forwarded-For entry is
# the real client, so rate limiting counts the caller and not a value the caller chose.
# 0 when the backend is reached directly, 1 behind the deployed Traefik.
TRUSTED_PROXY_COUNT=0

# Initial administrator (used only by the controlled CLI commands)
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Storage (self-hosted: uploaded media lives on local disk, no object storage service)
MEDIA_DIR=./data/media
PROJECT_SEED_ENABLED=true

# Optional personal content
CONTACT_EMAIL=
