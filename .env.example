# Public
PUBLIC_SITE_URL=http://localhost:5173
VITE_API_BASE_URL=/api/v1
INTERNAL_API_BASE_URL=http://localhost:8080/api/v1

# Database
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=jdbc:postgresql://localhost:5432/portfolio

# Spring
SPRING_PROFILES_ACTIVE=dev
SESSION_COOKIE_SECURE=false
SESSION_TIMEOUT=12h
SERVER_FORWARD_HEADERS_STRATEGY=framework

# Initial administrator — uniquement pour les commandes CLI contrôlées
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Storage
STORAGE_PROVIDER=s3
S3_BUCKET=portfolio-media
S3_REGION=eu-west-3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=replace-minio-secret
S3_PUBLIC_BASE_URL=http://localhost:9000/portfolio-media
PROJECT_SEED_ENABLED=true

# MinIO development
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-minio-secret

# Optional personal content
CONTACT_EMAIL=
